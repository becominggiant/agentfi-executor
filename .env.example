# ── Required ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                        # OpenAI API key for GPT-4o-mini

# ── Wallet (TESTNET ONLY — never use a mainnet wallet with real funds here) ───
PRIVATE_KEY=0x...                            # Private key for testnet registration/tx

# ── RPC Endpoints ──────────────────────────────────────────────────────────────
RPC_URL=https://sepolia.base.org             # Base Sepolia (testnet) — for writes
BASE_MAINNET_RPC=https://mainnet.base.org    # Base mainnet — read-only price data

# ── Agent Card ─────────────────────────────────────────────────────────────────
AGENT_URI=ipfs://YOUR_CID_HERE/agent_card.json  # Set after uploading to IPFS

# ── Monitoring Thresholds ──────────────────────────────────────────────────────
ALERT_BALANCE_ETH=0.01    # Alert when testnet wallet ETH drops below this amount
ALERT_GAS_GWEI=50         # Alert when mainnet gas price exceeds this (gwei)

# ── A2A Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
