# ── Required ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                        # OpenAI API key
OPENAI_MODEL=gpt-4o-mini                     # Model to use (e.g. gpt-4o, gpt-4o-mini)

# ── Wallet (TESTNET ONLY — never use a mainnet wallet with real funds here) ───
PRIVATE_KEY=0x...                            # Private key for testnet registration/tx

# ── RPC Endpoints ──────────────────────────────────────────────────────────────
RPC_URL=https://sepolia.base.org             # Base Sepolia (testnet) — for writes
BASE_MAINNET_RPC=https://mainnet.base.org    # Base mainnet — read-only price data

# ── Flash Loan Contract (set after running deploy_contract.py) ─────────────────
FLASH_ARBITRAGE_CONTRACT=0x...              # FlashArbitrage deployed address (Base Sepolia)

# ── DEX Router Overrides (optional — defaults shown) ──────────────────────────
# UNIV3_SWAP_ROUTER=0x94cC0AaC535CCDB3C01d6787D6413C739ae12bc4   # Base Sepolia
# AERODROME_ROUTER_EXEC=0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43
# AERODROME_FACTORY_EXEC=0x420DD381b31aEf6683db6B902084cB0FFECe40Da

# ── Aave V3 (optional — defaults shown) ───────────────────────────────────────
# AAVE_ADDRESSES_PROVIDER=0xE4C23309117Aa30342BFaae6c95c6478e0A4Ad00  # Base Sepolia
# For Base mainnet use: 0xe20fCBdBfFC4Dd138cE8b2E6FBb6CB49777ad64D

# ── Agent Card ─────────────────────────────────────────────────────────────────
AGENT_URI=ipfs://YOUR_CID_HERE/agent_card.json  # Set after uploading to IPFS

# ── Registration ───────────────────────────────────────────────────────────────
GAS_PRICE_MULTIPLIER=1.5    # Multiplier applied to current gas price for tx inclusion

# ── Monitoring Thresholds ──────────────────────────────────────────────────────
ALERT_BALANCE_ETH=0.01    # Alert when testnet wallet ETH drops below this amount
ALERT_GAS_GWEI=50         # Alert when mainnet gas price exceeds this (gwei)

# ── A2A Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
